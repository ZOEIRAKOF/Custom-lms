local function espiral(cor, dur, qtd, vel)
	task.spawn(function()
		local partes = {}
		for i = 1, (qtd or 30) do
			local f = Instance.new("Frame"); f.AnchorPoint = Vector2.new(0.5, 0.5); f.Size = UDim2.new(0, math.random(40, 130), 0, math.random(2, 5))
