local recentMsgs, recentCount = {}, 0
local function processarMensagemConsole(msg)
	msg = tostring(msg)
	if msg:find("^%[PLACA") or msg:find("^%[SCAN") or msg:find("^%[SYNC") or msg:find("STUN REAL", 1, true) then return end
	if placaEstado ~= "ativa" then return end
	local agora = os.clock(); local ultimo = recentMsgs[msg]
	if ultimo and (agora - ultimo) < 0.1 then return end
	recentMsgs[msg] = agora; recentCount = recentCount + 1
	if recentCount > 300 then recentMsgs = {}; recentCount = 0 end
	local low = msg:lower(); if DEBUG_PLACA then print("[PLACA] console: " .. msg) end
	if low:find("damage", 1, true) or low:find("dano", 1, true) then contarDano(); return end
end

