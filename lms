local musicaAutoAtiva, somLmsOrigem, travaAteParar = false, nil, false

local function acharSoloTheme()
	local CA = game:GetService("ReplicatedStorage"):FindFirstChild("ClientAssets")
	return CA and CA:FindFirstChild("Sounds") and CA.Sounds:FindFirstChild("mus") and CA.Sounds.mus:FindFirstChild("Game") and CA.Sounds.mus.Game:FindFirstChild("Round") and CA.Sounds.mus.Game.Round:FindFirstChild("SoloTheme")
end

local function algumLmsTocando(soloTheme)
	for _, som in ipairs(soloTheme:GetChildren()) do if som:IsA("Sound") and som.IsPlaying then return true end end
	return false
end

local function estouVivo()
	local c = LP.Character; if not c then return false end; local h = c:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return false end; if not c:IsDescendantOf(workspace) then return false end; if c.Name == "Nenhum" then return false end; return true
end

local function pararLms(motivo)
	if placaEstado == "ativa" or placaEstado == "entrando" then finalizarPlaca(estouVivo() and "amy" or "exe") end
	pararTodas(); painel.Visible = false; musicaAutoAtiva = false; somLmsOrigem = nil; travaAteParar = true
	pcall(function() RunService:UnbindFromRenderStep("SonicShake") end); if DEBUG_PLACA then print("[PLACA] LMS parada: " .. motivo) end
end

task.spawn(function()
	while true do
		task.wait(0.5); local soloTheme = acharSoloTheme()
		if not soloTheme then if musicaAutoAtiva then pararLms("SoloTheme sumiu") end; continue end
		if travaAteParar then if not algumLmsTocando(soloTheme) then travaAteParar = false end; continue end
		
		-- ✅ VERIFICAÇÃO DUPLA DE SEGURANÇA NO LOOP PRINCIPAL
		if musicaAutoAtiva then
			if not estouVivo() then 
				pararLms("morri / char removido") 
				continue
			end
			
			local gp = workspace:FindFirstChild("GameProperties")
			local time = gp and gp:FindFirstChild("Time")
			if time and time.Value <= 0 then
				pararLms("GameProperties.Time acabou")
				continue
			end

			local fonteParou = (not somLmsOrigem) or (not somLmsOrigem.Parent) or (not somLmsOrigem.IsPlaying)
			if fonteParou then 
				pararLms("som da LMS parou (fim de round)") 
			end
			continue
		end
		
		local lmsTocando, lmsInfo = nil, nil
		for _, info in ipairs(MUSICAS) do
			for _, som in ipairs(soloTheme:GetChildren()) do
				if som:IsA("Sound") and som.Name:lower():find(info.lms:lower()) and som.IsPlaying then lmsTocando = som; lmsInfo = info; break end
			end
			if lmsTocando then break end
		end
		if lmsTocando and lmsInfo and estouVivo() then
			tocarMusica(lmsInfo.nome); somLmsOrigem = lmsTocando; lblMusica.Text = lmsInfo.nome; lblPersonagem.Text = "🎭 " .. lmsInfo.personagem; painel.Visible = true; musicaAutoAtiva = true
		end
	end
end)

