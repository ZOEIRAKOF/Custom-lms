				stunAtivo = true; local agora = tick()
				if agora - ultimoStun > 0.5 then ultimoStun = agora; exeStunado = exe; if placaEstado == "ativa" then contarStun() end end
			end
			return
		end
	end
	stunAtivo = false; exeStunado = nil
