local mutedSounds = {}
local function muteGameSounds()
	mutedSounds = {}
	local CA = game:GetService("ReplicatedStorage"):FindFirstChild("ClientAssets")
	if not CA then return end
	local soloTheme = CA:FindFirstChild("Sounds") and CA.Sounds:FindFirstChild("mus") and CA.Sounds.mus:FindFirstChild("Game") and CA.Sounds.mus.Game:FindFirstChild("Round") and CA.Sounds.mus.Game.Round:FindFirstChild("SoloTheme")
	if soloTheme then
		for _, sound in ipairs(soloTheme:GetDescendants()) do
			if sound:IsA("Sound") and sound.Volume > 0 then
				mutedSounds[sound] = sound.Volume
				sound.Volume = 0
			end
		end
	end
end

local function restoreGameSounds()
	for sound, volume in pairs(mutedSounds) do
		if sound and sound.Parent then sound.Volume = volume end
	end
	mutedSounds = {}
end

local function loadCustomAsset(url, filename)
	if not isfile or not writefile or not getcustomasset then return nil end
	if not isfile(filename) then
		local ok, conteudo = pcall(function() return game:HttpGet(url) end)
		if not ok or not conteudo then return nil end
		writefile(filename, conteudo)
	end
	return getcustomasset(filename)
end

local musicasBaixadas = {}
local totalBaixadas, totalFalhas = 0, 0
for _, info in ipairs(MUSICAS) do
	task.spawn(function()
		local soundId = loadCustomAsset(info.url, info.arquivo)
		if soundId then
			local som = Instance.new("Sound")
			som.Name = info.nome
			som.SoundId = soundId
			som.Looped = true -- ✅ LOOP ATIVADO
			som.Volume = info.volume
			som.Parent = SoundService
			table.insert(musicasBaixadas, { som = som, info = info })
			totalBaixadas = totalBaixadas + 1
		else
			totalFalhas = totalFalhas + 1
			warn("⚠️ Falha ao baixar: " .. info.nome)
		end
	end)
end
repeat task.wait(0.5) until (totalBaixadas + totalFalhas) >= #MUSICAS

