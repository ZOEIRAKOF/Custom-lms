local stunAtivo, ultimoStun, exeStunado = false, 0, nil
local function detectarStunReal()
	local exe = encontrarExeModel(); if not exe then exeStunado = nil; stunAtivo = false; return end
	local hum = exe:FindFirstChildOfClass("Humanoid"); if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator"); if not animator then return end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		if track.Animation and track.Animation.AnimationId == ID_ANIM_STUN then
