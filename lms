		if musicaAtual.info.eventosSonic then tempo = tempo + OFFSET_SONIC end
		local segInt = math.floor(tempo)

		if segInt ~= ultimoTempoEfeito and musicaAtual.info.nome == "YOU CAN'T DO ANYTHING" then dispararEfeitoMetal(segInt, tempo); ultimoTempoEfeito = segInt end

		if musicaAtual.info.robos and #musicaAtual.info.robos > 0 then
			for _, t in ipairs(musicaAtual.info.robos) do if segInt == t and ultimoTempoEfeito ~= t then animarRobosCantos(); ultimoTempoEfeito = t; break end end
		end

		if musicaAtual.info.furyTempos then
			local mostrarFury = false
			for _, tempoFury in ipairs(musicaAtual.info.furyTempos) do if tempo >= tempoFury[1] and tempo <= tempoFury[2] then mostrarFury = true; break end end
			if mostrarFury and not furyAnterior then flashTela(0.16); imgFury.Visible = true elseif not mostrarFury and furyAnterior then imgFury.Visible = false end
			furyAnterior = mostrarFury
		else imgFury.Visible = false; furyAnterior = false end

		if musicaAtual.info.tailsImageTime then
			if tempo >= musicaAtual.info.tailsImageTime then
				if not tailsImageAtiva then tailsImageAtiva = true; flashTela(2.0); imgTails.Visible = true; iniciarMovimentoCortina() end
			else if tailsImageAtiva then tailsImageAtiva = false; imgTails.Visible = false; pararMovimentoCortina() end end
		else if tailsImageAtiva then tailsImageAtiva = false; imgTails.Visible = false; pararMovimentoCortina() end end

		-- ⚡ EVENTOS SONIC
		if musicaAtual.info.eventosSonic then
			if tempo < 2 and next(sonicFeitos) ~= nil then sonicFeitos = {} end
			for i, ev in ipairs(EVENTOS_SONIC) do if not sonicFeitos[i] and tempo >= ev.t then sonicFeitos[i] = true; task.spawn(eventoSonic, ev) end end
		end

		-- 🔥 EVENTOS KNUCKLES
		if musicaAtual.info.eventosKnuckles then
			if tempo < 2 and next(knucklesFeitos) ~= nil then knucklesFeitos = {} end
			for i, ev in ipairs(EVENTOS_KNUCKLES) do if not knucklesFeitos[i] and tempo >= ev.t then knucklesFeitos[i] = true; task.spawn(eventoKnuckles, ev) end end
		end

		-- 🔮 EVENTOS SILVER
		if musicaAtual.info.eventosSilver then
			if tempo < 2 and next(silverFeitos) ~= nil then silverFeitos = {} end
			for i, ev in ipairs(EVENTOS_SILVER) do 
				if not silverFeitos[i] and tempo >= ev.t then 
					silverFeitos[i] = true
					task.spawn(eventoSilver, ev) 
				end 
			end
		end

		local cfgPlaca = musicaAtual.info.placa
		if cfgPlaca then
			if tempo >= cfgPlaca.inicio and tempo < cfgPlaca.fim and not placaJaMostrada then mostrarPlacaAmy() end
			if tempo >= cfgPlaca.fim and (placaEstado == "ativa" or placaEstado == "entrando") then finalizarPlaca("amy") end
		end

		local letra = LETRAS[musicaAtual.info.nome]
		if letra then
			aplicarEstiloLegenda(musicaAtual.info); local textoAtual, textoSpecial, textoEcho, textoBig, textoDur = "", "", false, false, nil
			for _, entrada in ipairs(letra) do if tempo >= entrada.time then textoAtual = entrada.text or ""; textoSpecial = entrada.special or ""; textoEcho = entrada.echo or false; textoBig = entrada.big or false; textoDur = entrada.dur else break end end

			if estiloLegendaAtual == "sonic" then gradLetra.Offset = Vector2.new(math.sin(tempo*1.6)*0.18, 0); gradGrande.Offset = Vector2.new(math.sin(tempo*1.6)*0.18, 0) end

			if textoAtual ~= "" and textoBig then
				if textoAtual ~= ultimaLetra then ultimaLetra = textoAtual; mostrarLetraGrande(textoAtual, textoDur or 1.8) end
				if legendaVisivel then TweenService:Create(labelLetra, TweenInfo.new(0.25), {TextTransparency = 1}):Play(); TweenService:Create(labelLetraContainer, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play(); legendaVisivel = false end
			elseif textoAtual ~= "" then
				esconderLetraGrande()
				if not legendaVisivel then
					labelLetraContainer.Visible = true; labelLetraContainer.BackgroundTransparency = 1; labelLetra.TextTransparency = 1
					if not legendaSemFundo then TweenService:Create(labelLetraContainer, TweenInfo.new(0.25), {BackgroundTransparency = 0.35}):Play() end
					TweenService:Create(labelLetra, TweenInfo.new(0.25), {TextTransparency = 0}):Play(); legendaVisivel = true
				end
				labelLetra.Text = textoAtual
				if estiloLegendaAtual == "sonic" then local n = #textoAtual; labelLetra.TextSize = (n > 60 and 20) or (n > 45 and 24) or (n > 32 and 27) or 30; labelLetra.TextStrokeColor3 = Color3.fromRGB(0, 35, 90)
				elseif legendaSemFundo then labelLetra.TextSize = textoEcho and 21 or 26; labelLetra.TextColor3 = Color3.fromRGB(255, 110, 200); labelLetra.TextStrokeColor3 = Color3.fromRGB(80, 15, 55)
				else labelLetra.TextColor3 = musicaAtual.info.cor; labelLetra.TextStrokeColor3 = musicaAtual.info.cor:Lerp(Color3.new(0, 0, 0), 0.55) end

				if textoSpecial == "LEFT_RIGHT" then if not textoEspecialAtivo then textoEspecialAtivo = true; criarLeftRightPiscando(musicaAtual.info.cor) end
				else if textoEspecialAtivo then textoEspecialAtivo = false; for _, lbl in ipairs(letrasEspeciais) do if lbl then lbl:Destroy() end end; letrasEspeciais = {} end end

				if textoAtual ~= ultimaLetra then
					ultimaLetra = textoAtual; labelLetra.TextTransparency = 0.55; labelLetra.Size = UDim2.new(0.93, -20, 0.93, -20)
					TweenService:Create(labelLetra, TweenInfo.new(0.30, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0, Size = UDim2.new(1, -20, 1, -20)}):Play()
				end
			else
				esconderLetraGrande()
				if legendaVisivel then
					TweenService:Create(labelLetra, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 1}):Play()
					TweenService:Create(labelLetraContainer, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
					task.delay(0.6, function() if labelLetra.TextTransparency >= 0.95 then labelLetraContainer.Visible = false; labelLetra.Text = "" end end); legendaVisivel = false
				end
				if textoEspecialAtivo then textoEspecialAtivo = false; for _, lbl in ipairs(letrasEspeciais) do if lbl then lbl:Destroy() end end; letrasEspeciais = {} end
				ultimaLetra = ""
			end
		end
	else
		labelLetraContainer.Visible = false; grandeFrame.Visible = false; grandeAtivo = false; imgFury.Visible = false; imgTails.Visible = false
		legendaVisivel = false; furyAnterior = false; tailsImageAtiva = false; ultimaLetra = ""; pararMovimentoCortina(); esconderPlacaInstant()
		if textoEspecialAtivo then textoEspecialAtivo = false; for _, lbl in ipairs(letrasEspeciais) do if lbl then lbl:Destroy() end end; letrasEspeciais = {} end
	end
end)

